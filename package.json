{
  "name": "@rockthecoin/contracts",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify:builds": "node scripts/verify-builds.mjs",
    "verify:integrity": "node scripts/verify-integrity.mjs && python3 scripts/verify-algorand.py && node scripts/verify-bitcoin.mjs",
    "verify:chain": "node scripts/verify-chain.mjs",
    "verify:source": "node scripts/verify-sourcify.mjs",
    "verify:tron-builds": "node scripts/verify-tron-builds.mjs",
    "verify:tron-chain": "node scripts/verify-tron-chain.mjs",
    "verify:cardano": "python3 scripts/verify-cardano.py",
    "verify:cardano-builds": "python3 scripts/rebuild-cardano.py",
    "verify:cardano-chain": "python3 scripts/verify-cardano-chain.py",
    "verify:sui": "node scripts/verify-sui.mjs",
    "verify:sui-builds": "node scripts/rebuild-sui-suite.mjs && node scripts/rebuild-sui-creators-v2.mjs",
    "test:sui": "node scripts/test-sui-suite.mjs && node scripts/test-sui-creators-v2.mjs",
    "verify:sui-chain": "node scripts/verify-sui-chain.mjs",
    "verify:algorand": "python3 scripts/verify-algorand.py",
    "verify:algorand-builds": "python3 scripts/rebuild-algorand.py",
    "verify:algorand-chain": "python3 scripts/verify-algorand-chain.py",
    "verify:ton": "node scripts/verify-ton.mjs",
    "verify:ton-builds": "node scripts/compile-ton-suite.mjs --verify && node scripts/compile-ton-suite-v2.mjs --verify",
    "verify:ton-chain": "node scripts/verify-ton-chain.mjs",
    "test:ton": "node --test tests/ton-contracts.test.mjs",
    "verify:bitcoin": "node scripts/verify-bitcoin.mjs",
    "test:bitcoin": "npm --prefix contracts/bitcoin-protocol-v1 test"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@mysten/move-bytecode-template": "0.4.1",
    "@mysten/sui": "2.36.0",
    "@noble/curves": "1.9.7",
    "@ton/core": "0.63.1",
    "@ton/sandbox": "0.45.0",
    "@ton/tolk-js": "1.5.0",
    "solc": "0.8.30",
    "solc-v838": "npm:solc@0.8.38",
    "viem": "2.57.6"
  }
}
