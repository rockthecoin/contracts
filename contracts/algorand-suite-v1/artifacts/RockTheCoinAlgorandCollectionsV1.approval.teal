    app_global_put
    bytec_3 // "pending_owner"
    global ZeroAddress
    app_global_put
    intc_1 // 1
    return

accept_operator_bool_false@4:
    intc_0 // 0
    b accept_operator_bool_merge@5


// common.Service.resources[routing]() -> void:
resources:
    txn RekeyTo
    global ZeroAddress
    ==
    assert
    intc_1 // 1
    return


// common.Service.funded(payment: uint64) -> uint64:
funded:
    proto 1 1
    txn RekeyTo
    global ZeroAddress
    ==
    assert
    frame_dig -1
    gtxns Sender
    txn Sender
    ==
    bz funded_bool_false@3
    frame_dig -1
    gtxns Receiver
    global CurrentApplicationAddress
    ==
    bz funded_bool_false@3
    intc_1 // 1

funded_bool_merge@4:
    assert
    frame_dig -1
    gtxns RekeyTo
    global ZeroAddress
    ==
    bz funded_bool_false@7
    frame_dig -1
    gtxns CloseRemainderTo
    global ZeroAddress
    ==
    bz funded_bool_false@7
    intc_1 // 1

funded_bool_merge@8:
    assert
    global CurrentApplicationAddress
    dupn 2
    acct_params_get AcctBalance
    assert // account funded
    frame_dig -1
    gtxns Amount
    -
    dup
    uncover 2
    acct_params_get AcctMinBalance
    assert // account funded
    >=
    bz funded_ternary_false@10
    swap
    acct_params_get AcctMinBalance
    assert // account funded
    -
    retsub

funded_ternary_false@10:
    popn 2
    intc_0 // 0
    retsub

funded_bool_false@7:
    intc_0 // 0
    b funded_bool_merge@8

funded_bool_false@3:
    intc_0 // 0
    b funded_bool_merge@4


// common.Service.refund(floor: uint64) -> void:
refund:
    proto 1 0
    global CurrentApplicationAddress
    dup
    acct_params_get AcctBalance
    assert // account funded
    dig 1
    acct_params_get AcctMinBalance
    assert // account funded
    frame_dig -1
    +
    >=
    assert
    dup
    acct_params_get AcctBalance
    assert // account funded
    swap
    acct_params_get AcctMinBalance
    assert // account funded
    -
    frame_dig -1
    -
    dup
    bz refund_after_if_else@3
    itxn_begin
    txn Sender
    frame_dig 0
    itxn_field Amount
    itxn_field Receiver
    intc_1 // pay
    itxn_field TypeEnum
    intc_0 // 0
    itxn_field Fee
    itxn_submit

refund_after_if_else@3:
    retsub
